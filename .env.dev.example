# Copy to .env.dev and adjust as needed for local development.
DJANGO_DEBUG=1
DATABASE_URL=postgresql://postgis:postgis@postgis:5432/dev_mozzart_db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30
OPENAI_ORG=
OPENAI_PROJECT=

# Print bridge + Tailscale (Headscale)
# Unesi Headscale auth key za print bridge sidecar:
# tailscale up --login-server=https://hs-control.qubitsecured.online --authkey=...
TS_AUTHKEY_PRINT_BRIDGE=
PRINT_BRIDGE_URL=http://print_bridge:8090
PRINT_BRIDGE_API_TOKEN=
PRINT_BRIDGE_RECEIVER_TOKEN=

# Windows receiver / printer defaults (moze i po POS config-u)
BARION_BAR_PRINTER_ENABLED=true
BARION_BAR_RECEIVER_URL=
BARION_BAR_PRINTER_NAME=
POS_RECEIPT_RECEIVER_URL=
POS_RECEIPT_PRINTER_NAME=
